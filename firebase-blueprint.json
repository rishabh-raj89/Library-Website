{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Seat": {
      "title": "Seat",
      "description": "A study seat in the library",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "string" },
        "type": { "type": "string", "enum": ["standard", "reserved"] },
        "isOccupied": { "type": "boolean" },
        "currentUserId": { "type": "string" }
      },
      "required": ["id", "number", "type", "isOccupied"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A record of a seat booking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "seatId": { "type": "string" },
        "planName": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "expired"] },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "paymentId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "seatId", "planName", "amount", "status", "startTime", "endTime"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "seats/{seatId}": {
      "schema": "Seat",
      "description": "Library seats status"
    },
    "bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Booking records"
    }
  }
}
