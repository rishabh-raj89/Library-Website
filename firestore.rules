rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 1. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == request.auth.uid 
          && data.email is string 
          && data.email.size() <= 256;
      }

      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        );
    }

    // 2. Seats Collection (Public Read, Admin Write)
    match /seats/{seatId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && isValidId(seatId)); // Allow users for initial demo setup
      allow update, delete: if isAdmin() 
        || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['isOccupied', 'currentUserId']));
    }

    // 3. Bookings Collection
    match /bookings/{bookingId} {
      function isValidBooking(data) {
        return data.userId == request.auth.uid
          && data.seatId is string
          && data.amount is number
          && data.status in ['pending', 'confirmed', 'expired']
          && (data.status != 'confirmed' || data.paymentId is string);
      }

      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidBooking(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() || (isSignedIn() && isOwner(existing().userId) && isValidBooking(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentId']));
      allow delete: if isAdmin();
    }

    // 4. Admin Auth Helper (Private)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.token.email == "royalrishabhrajput8953@gmail.com";
    }

    // 5. Reset Tokens (For Admin Secondary Password)
    match /reset_tokens/{tokenId} {
      allow read: if true; // Needed to check token validity
      allow create: if false; // Only via backend (simulated) or special rules
      allow update, delete: if true; // To consume token
    }
  }
}
